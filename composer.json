{
    "name": "asimnet/ummulqura-calendar",
    "description": "Exact Gregorian <-> Hijri date conversion on the official Saudi Umm al-Qura calendar (KACST tables). Pure PHP, zero dependencies.",
    "keywords": [
        "hijri",
        "umm-al-qura",
        "calendar",
        "date",
        "islamic",
        "saudi",
        "kacst"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AsimNet/ummulqura-calendar",
    "support": {
        "issues": "https://github.com/AsimNet/ummulqura-calendar/issues",
        "source": "https://github.com/AsimNet/ummulqura-calendar"
    },
    "authors": [
        {
            "name": "AsimNet"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AsimNet\\UmmulquraCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimNet\\UmmulquraCalendar\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
